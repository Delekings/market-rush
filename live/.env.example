# Market Rush Live settings. Save this file after editing.

# Passcode for the phone remote. Pick something only you know.
CONTROL_PASSCODE=change-me

# YouTube stream key (YouTube app or Studio > Go live > Stream). You can also type it in the remote instead.
YT_STREAM_KEY=

# YouTube Data API key, for reading live chat (Google Cloud Console > enable YouTube Data API v3 > Credentials > API key).
YT_API_KEY=

# How often chat is read, in milliseconds. Higher uses less of your daily API quota.
CHAT_POLL_MS=5000

# Video quality. If your upload speed is under 5 Mbps, try VIDEO_KBPS=2500.
VIDEO_KBPS=3500
FPS=30
X264_PRESET=veryfast
